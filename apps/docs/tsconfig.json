{
  "extends": "../../packages/creed-app/tsconfig.base.json",
  "compilerOptions": {
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["../../packages/creed-app/*"],
      "@creed/integrations/*": ["../../packages/integrations/*"],
      "@creed/persistence/supabase/*": ["../../packages/persistence/supabase-client/*"],
      "@creed/core/*": ["../../packages/creed-core/*"],
      "@creed/ui/*": ["../../packages/creed-ui/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", "../../packages/creed-app/tests"]
}
