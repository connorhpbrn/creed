# Creed Open v1 environment
#
# Copy this file to `.env.local`. Values prefixed with NEXT_PUBLIC_ are exposed
# to the browser. Every other value must remain server-only.

# Required: the exact origin people use to open this installation.
# Local: http://localhost:3001
# Vercel: https://your-project.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Required: Supabase project values from Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Required: private installation owner secret. Use 32 characters or more.
# Generate with: openssl rand -base64 48
CREED_OWNER_SECRET=

# Required: encrypts API keys and connection tokens at rest.
# Generate with: openssl rand -base64 32
CREED_ENCRYPTION_SECRET=

# Optional during encryption-key rotation. Remove after stored secrets have
# been rewritten through normal use.
CREED_ENCRYPTION_SECRET_PREVIOUS=

# Optional: GitHub version control. Create a GitHub OAuth App with callback:
# <NEXT_PUBLIC_SITE_URL>/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Optional: public repository and project links.
NEXT_PUBLIC_GITHUB_URL=https://github.com/connorhpbrn/creed
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_LEGAL_OPERATOR_NAME=
NEXT_PUBLIC_TWITTER_URL=
NEXT_PUBLIC_INSTAGRAM_URL=

# Optional: detailed health checks shared with a status deployment.
CREED_HEALTH_SECRET=

# Optional production emergency switch. Production enforces CSP by default.
# CREED_CSP_ENFORCE=0

# Optional build diagnostics.
# ANALYZE=true
# NEXT_PUBLIC_RELEASE_SHA=
