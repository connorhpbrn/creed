{
  "name": "creed-cloud",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --max-http-header-size=65536 ../../node_modules/next/dist/bin/next dev -p 3000",
    "build": "next build",
    "start": "node --max-http-header-size=65536 ../../node_modules/next/dist/bin/next start -p 3000",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --no-seed",
    "db:migrations": "supabase migration list --linked",
    "db:advisors": "supabase db advisors --linked --type all --fail-on error",
    "lint": "eslint",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@creed/app": "*",
    "@creed/cloud": "*",
    "next": "16.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "typescript": "^5"
  }
}
