{
  "name": "creed-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace creed",
    "dev:status": "npm run dev --workspace creed-status",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "bench": "npm run bench --workspace creed --",
    "indexnow": "npm run indexnow --workspace creed"
  }
}
